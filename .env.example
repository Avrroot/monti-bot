# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
DEFAULT_LOCALE=ru

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to hit admin endpoints/commands
TELEGRAM_ADMIN_IDS=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://savebot:savebot@postgres:5432/savebot
POSTGRES_USER=savebot
POSTGRES_PASSWORD=savebot
POSTGRES_DB=savebot

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- AI: LLM (structured content analysis + search query parsing) ---
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Override to point at any OpenAI-compatible endpoint
AI_BASE_URL=

# --- AI: Embeddings ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- AI: Vision (screenshots/images) ---
VISION_PROVIDER=openai
VISION_MODEL=gpt-4o-mini

# --- Object storage (screenshots) ---
# "local": shared Docker volume, no image to pull, zero external dependency
# (default). "s3": MinIO/real S3 -- needs `docker compose --profile s3` and
# the S3_* vars below.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/data/screenshots
S3_ENDPOINT=http://minio:9000
S3_BUCKET=savebot
S3_ACCESS_KEY=savebot
S3_SECRET_KEY=savebot123456
S3_REGION=us-east-1

# --- Observability ---
SENTRY_DSN=

# --- Admin API ---
ADMIN_API_TOKEN=

# --- Outbound proxy ---
# Only needed if this VPS has no direct route to Telegram/OpenAI/social
# platforms. Routes ALL outbound HTTP from bot/worker/api through an `ssh -D`
# SOCKS5 tunnel to a jump host that does have direct access (see the `proxy`
# service in docker-compose.yml, started with `--profile proxy`).
# Leave both empty for a VPS with normal direct internet access.
#
# Must be plain socks5:// (not socks5h://) -- aiogram's proxy backend
# (aiohttp-socks) rejects the socks5h:// scheme outright. Both it and
# httpx's SOCKS transport always resolve DNS through the proxy regardless of
# the scheme suffix, so this loses nothing: this host doesn't need to (and
# may not be able to) resolve these hostnames itself either way.
PROXY_URL=
# PROXY_URL=socks5://proxy:1080
PROXY_SSH_HOST=
PROXY_SSH_PORT=22
PROXY_SSH_USER=
# Path (on the VPS host, not in the container) to the private key used for
# the tunnel. Put it in ./secrets/ (gitignored), never commit it.
PROXY_SSH_KEY_PATH=./secrets/proxy_ssh_key
